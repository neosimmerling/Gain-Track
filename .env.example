# Kopiere diese Datei zu ".env" und passe die Werte an, bevor du startest:
#   cp .env.example .env

# Zufälligen Schlüssel erzeugen z.B. mit: openssl rand -hex 32
SECRET_KEY=bitte-aendern-lange-zufaellige-zeichenkette

# Port, unter dem die Web-App auf dem Pi erreichbar ist
WEB_PORT=6767

# Bei Zugriff nur über Tailscale kann * bleiben.
# Für öffentlichen Zugriff auf eine feste Domain einschränken, z.B.:
# CORS_ORIGINS=https://gaintrack.example.com
CORS_ORIGINS=*
